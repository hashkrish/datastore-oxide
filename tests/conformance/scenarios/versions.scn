# Version numbers: per-project commit counter, no-op writes, deletes of missing entities.
POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "K", "name": "a"}]}, "properties": {"v": {"integerValue": "1"}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "K", "name": "a"}]}, "properties": {"v": {"integerValue": "1"}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "K", "name": "a"}]}, "properties": {"v": {"integerValue": "2"}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "K", "name": "a"}]}, "properties": {"v": {"integerValue": "2", "excludeFromIndexes": true}}}}]}

POST /v1/projects/q:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "K", "name": "a"}]}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"partitionId": {"namespaceId": "ns"}, "path": [{"kind": "K", "name": "a"}]}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"delete": {"path": [{"kind": "K", "name": "missing"}]}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "G", "name": "g"}]}}}, {"upsert": {"key": {"path": [{"kind": "G", "name": "g"}, {"kind": "C", "name": "c"}]}}}, {"delete": {"path": [{"kind": "K", "name": "a"}]}}]}

POST /v1/projects/p:lookup
{"keys": [{"path": [{"kind": "K", "name": "a"}]}, {"path": [{"kind": "G", "name": "g"}]}, {"path": [{"kind": "Nope", "name": "x"}]}]}

POST /v1/projects/fresh:lookup
{"keys": [{"path": [{"kind": "K", "name": "a"}]}]}
