# Ancestor paths, namespaces and explicit partition ids.
POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [
  {"insert": {"key": {"path": [{"kind": "P", "name": "root"}, {"kind": "C"}]}}},
  {"insert": {"key": {"path": [{"kind": "P", "id": "9"}, {"kind": "C", "name": "x"}, {"kind": "G"}]}}},
  {"upsert": {"key": {"partitionId": {"namespaceId": "ns1"}, "path": [{"kind": "K", "name": "a"}]}}},
  {"upsert": {"key": {"partitionId": {"projectId": "p", "namespaceId": ""}, "path": [{"kind": "K", "name": "b"}]}}}
]}

POST /v1/projects/p:lookup
{"keys": [
  {"path": [{"kind": "P", "name": "root"}, {"kind": "C", "id": "1"}]},
  {"path": [{"kind": "P", "id": "9"}, {"kind": "C", "name": "x"}, {"kind": "G", "id": "2"}]},
  {"partitionId": {"namespaceId": "ns1"}, "path": [{"kind": "K", "name": "a"}]},
  {"path": [{"kind": "K", "name": "a"}]},
  {"partitionId": {"projectId": "p"}, "path": [{"kind": "K", "name": "b"}]}
]}

POST /v1/projects/other:lookup
{"keys": [{"path": [{"kind": "K", "name": "b"}]}]}
