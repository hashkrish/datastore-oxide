# Export strips __scatter__ and embedded-entity index data from stored entities (survives a restart).
ARGS --consistency=1.0 {dir}
SETUP WEB-INF/index.yaml
indexes:
# AUTOGENERATED
END

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "E", "id": "7"}]}, "properties": {"ent": {"entityValue": {"properties": {"x": {"integerValue": "1"}}}}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "E", "id": "8"}]}, "properties": {"n": {"integerValue": "1"}}}}]}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "E"}], "filter": {"propertyFilter": {"property": {"name": "ent.x"}, "op": "EQUAL", "value": {"integerValue": "1"}}}}}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "E", "id": "7"}]}, "properties": {"ent": {"entityValue": {"properties": {"x": {"integerValue": "1"}}}}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "E", "id": "8"}]}, "properties": {"n": {"integerValue": "1"}}}}]}

POST /v1/projects/p:export
{"outputUrlPrefix": "{dir}/exp"}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "E"}], "filter": {"propertyFilter": {"property": {"name": "ent.x"}, "op": "EQUAL", "value": {"integerValue": "1"}}}}}

RESTART

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "E"}], "filter": {"propertyFilter": {"property": {"name": "ent.x"}, "op": "EQUAL", "value": {"integerValue": "1"}}}}}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "E", "id": "7"}]}, "properties": {"ent": {"entityValue": {"properties": {"x": {"integerValue": "1"}}}}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "E", "id": "8"}]}, "properties": {"n": {"integerValue": "1"}}}}]}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "E"}], "filter": {"propertyFilter": {"property": {"name": "ent.x"}, "op": "EQUAL", "value": {"integerValue": "1"}}}}}
