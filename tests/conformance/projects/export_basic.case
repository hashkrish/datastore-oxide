 "str": {"stringValue": "héllo\u0001\"\n<>&=/ "}, "str0": {"stringValue": ""}, "blob": {"blobValue": "AAECAw=="}, "blob0": {"blobValue": ""},
 "geo": {"geoPointValue": {"latitude": 1.5, "longitude": -2}}, "geo0": {"geoPointValue": {}},
 "ent": {"entityValue": {"properties": {"x": {"integerValue": "1"}, "inner": {"entityValue": {"properties": {"y": {"stringValue": "z"}}}}}}},
 "ent0": {"entityValue": {}}, "entk": {"entityValue": {"key": {"path": [{"kind": "E", "name": "e"}]}, "properties": {"q": {"booleanValue": false}}}},
