# YAML with --regenerate_indexes=false: manual indexes above the marker, old generated ones carried over.
ARGS --regenerate_indexes=false --consistency=1.0 {dir}
SETUP WEB-INF/index.yaml
indexes:
- kind: K
  properties:
  - name: a
  - name: b
    direction: desc

- kind: "K"
  ancestor: yes
  properties:
  - name: x
  - name: c

# AUTOGENERATED

# old comment
- kind: K
  properties:
  - name: old
  - name: older
    direction: desc
END

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "a"}}, {"property": {"name": "b"}, "direction": "DESCENDING"}]}}

FILE WEB-INF/index.yaml
POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "c"}}, {"property": {"name": "d"}}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "old"}}, {"property": {"name": "older"}, "direction": "DESCENDING"}]}}

FILE WEB-INF/index.yaml