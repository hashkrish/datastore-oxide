# YAML without the AUTOGENERATED marker: missing indexes fail.
ARGS --consistency=1.0 {dir}
SETUP WEB-INF/index.yaml
indexes:
- kind: K
  properties:
  - name: a
  - name: b
    direction: desc

- kind: "K"
  ancestor: yes
  properties:
  - name: x
  - name: c
END

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "a"}}, {"property": {"name": "b"}, "direction": "DESCENDING"}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "c"}}, {"property": {"name": "d"}}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "c"}}, {"property": {"name": "d"}}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "filter": {"propertyFilter": {"property": {"name": "__key__"}, "op": "HAS_ANCESTOR", "value": {"keyValue": {"path": [{"kind": "P", "name": "a"}]}}}}, "order": [{"property": {"name": "c"}}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "filter": {"compositeFilter": {"op": "AND", "filters": [{"propertyFilter": {"property": {"name": "__key__"}, "op": "HAS_ANCESTOR", "value": {"keyValue": {"path": [{"kind": "P", "name": "a"}]}}}}, {"propertyFilter": {"property": {"name": "x"}, "op": "EQUAL", "value": {"integerValue": "1"}}}]}}, "order": [{"property": {"name": "c"}}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "filter": {"propertyFilter": {"property": {"name": "x"}, "op": "EQUAL", "value": {"integerValue": "1"}}}, "order": [{"property": {"name": "c"}}]}}

FILE WEB-INF/index.yaml