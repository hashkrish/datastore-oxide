# YAML by default (--regenerate_indexes=true) drops old generated indexes.
ARGS --consistency=1.0 {dir}
SETUP WEB-INF/index.yaml
indexes:
- kind: K
  properties:
  - name: a
  - name: b
    direction: desc

- kind: "K"
  ancestor: yes
  properties:
  - name: x
  - name: c

# AUTOGENERATED

# old comment
- kind: K
  properties:
  - name: old
  - name: older
    direction: desc
END

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "c"}}, {"property": {"name": "d"}}]}}

FILE WEB-INF/index.yaml