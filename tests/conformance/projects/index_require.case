# --require_indexes checks every run; the verified set is loaded once.
ARGS --require_indexes --consistency=1.0 {dir}
SETUP WEB-INF/index.yaml
indexes:
- kind: K
  properties:
  - name: a
  - name: b
    direction: desc

- kind: "K"
  ancestor: yes
  properties:
  - name: x
  - name: c

# AUTOGENERATED

# old comment
- kind: K
  properties:
  - name: old
  - name: older
    direction: desc
END

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "a"}}, {"property": {"name": "b"}, "direction": "DESCENDING"}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "c"}}, {"property": {"name": "d"}}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "c"}}, {"property": {"name": "d"}}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "e"}}, {"property": {"name": "f"}}]}}

FILE WEB-INF/index.yaml
POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "c"}}, {"property": {"name": "d"}}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "old"}}, {"property": {"name": "older"}, "direction": "DESCENDING"}]}}

RESTART

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "c"}}, {"property": {"name": "d"}}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}], "order": [{"property": {"name": "e"}}, {"property": {"name": "f"}}]}}

