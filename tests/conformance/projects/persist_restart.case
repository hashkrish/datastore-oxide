{"keys": [{"path": [{"kind": "K", "name": "q"}]}]}

POST /v1/projects/p:lookup
{"keys": [{"path": [{"kind": "K", "name": "d"}]}], "databaseId": "db1"}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "K"}]}, "partitionId": {"namespaceId": "ns1"}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "__namespace__"}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "__kind__"}]}}

POST /v1/projects/p:runQuery
{"query": {"kind": [{"name": "__property__"}]}}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "K", "name": "a"}]}, "properties": {"v": {"integerValue": "8"}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"insert": {"key": {"path": [{"kind": "K"}]}, "properties": {"v": {"integerValue": "9"}}}}]}

POST /v1/projects/p:allocateIds
{"keys": [{"path": [{"kind": "K"}]}]}

POST /v1/projects/p:lookup
{"keys": [{"path": [{"kind": "K", "name": "a"}]}], "readOptions": {"transaction": "{{t}}"}}

POST /v1/projects/p:rollback
{"transaction": "{{t}}"}

POST /reset

POST /persist
