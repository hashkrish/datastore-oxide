# Export kind order: Java hash-table order, reversed within buckets by a restart (deserialization).
ARGS --consistency=1.0 {dir}
SETUP WEB-INF/index.yaml
indexes:
# AUTOGENERATED
END

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "A", "name": "x"}]}, "properties": {"v": {"integerValue": "1"}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "Q", "name": "x"}]}, "properties": {"v": {"integerValue": "1"}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "a", "name": "x"}]}, "properties": {"v": {"integerValue": "1"}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "B", "name": "x"}]}, "properties": {"v": {"integerValue": "1"}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "C", "name": "x"}]}, "properties": {"v": {"integerValue": "1"}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "D", "name": "x"}]}, "properties": {"v": {"integerValue": "1"}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "b", "name": "x"}]}, "properties": {"v": {"integerValue": "1"}}}}]}

POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "r", "name": "x"}]}, "properties": {"v": {"integerValue": "1"}}}}]}

POST /v1/projects/p:export
{"outputUrlPrefix": "{dir}/one"}

ENTITIES one/*/all_namespaces/all_kinds/output-0
RESTART

POST /v1/projects/p:export
{"outputUrlPrefix": "{dir}/two"}

ENTITIES two/*/all_namespaces/all_kinds/output-0
POST /v1/projects/p:commit
{"mode": "NON_TRANSACTIONAL", "mutations": [{"upsert": {"key": {"path": [{"kind": "q", "name": "x"}]}, "properties": {"v": {"integerValue": "1"}}}}]}

POST /v1/projects/p:export
{"outputUrlPrefix": "{dir}/three"}

ENTITIES three/*/all_namespaces/all_kinds/output-0